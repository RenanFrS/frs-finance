# --- Postgres / docker-compose ---
POSTGRES_DB=frs_finance
POSTGRES_USER=frs
POSTGRES_PASSWORD=frs_local_dev
POSTGRES_PORT=5432

# --- Prisma / app runtime ---
# Pooled connection — usada como `url` no schema
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Direct connection (sem pgbouncer) — usada como `directUrl`; necessária para `prisma migrate`
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# --- Sessão (cookie assinado por HMAC-SHA256) ---
# Gere com `openssl rand -hex 32`
SESSION_SECRET="change-me-32-bytes-hex-or-longer-string"
